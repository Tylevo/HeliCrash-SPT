<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)../../SPT.Build.props" />
  <PropertyGroup>
    <RootNamespace>SamSWAT.HeliCrash.ArysReloaded</RootNamespace>
    <AssemblyName>Tylevo.HeliCrash.Core</AssemblyName>
    <TargetFramework>netstandard2.1</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <CopyToOutputDir>$(MSBuildThisFileDirectory)CopyToOutput\</CopyToOutputDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(SptBepInExCoreDir)0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Sirenix.Serialization">
      <HintPath>$(SptTarkovManagedDir)Sirenix.Serialization.dll</HintPath>
    </Reference>
    <Reference Include="spt-common">
      <HintPath>$(SptBepInExPluginsDir)spt\spt-common.dll</HintPath>
    </Reference>
    <Reference Include="spt-custom">
      <HintPath>$(SptBepInExPluginsDir)spt\spt-custom.dll</HintPath>
    </Reference>
    <Reference Include="spt-reflection">
      <HintPath>$(SptBepInExPluginsDir)spt\spt-reflection.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SptTarkovManagedDir)Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(SptBepInExCoreDir)BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(SptTarkovManagedDir)Comfort.dll</HintPath>
    </Reference>
    <Reference Include="Mono.Cecil">
      <HintPath>$(SptBepInExCoreDir)Mono.Cecil.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(SptTarkovManagedDir)Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="UniTask">
      <HintPath>$(SptBepInExPluginsDir)UnityToolkit\UniTask.dll</HintPath>
    </Reference>
    <Reference Include="UniTask.Linq">
      <HintPath>$(SptBepInExPluginsDir)UnityToolkit\UniTask.Linq.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptTarkovManagedDir)UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AIModule">
      <HintPath>$(SptTarkovManagedDir)UnityEngine.AIModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.AssetBundleModule">
      <HintPath>$(SptTarkovManagedDir)UnityEngine.AssetBundleModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptTarkovManagedDir)UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(SptTarkovManagedDir)UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="VContainer">
      <HintPath>$(SptBepInExPluginsDir)UnityToolkit\VContainer.dll</HintPath>
    </Reference>
    <Reference Include="ZLinq">
      <HintPath>$(SptBepInExPluginsDir)UnityToolkit\ZLinq.dll</HintPath>
    </Reference>
    <Reference Include="ZLinq.Unity">
      <HintPath>$(SptBepInExPluginsDir)UnityToolkit\ZLinq.Unity.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Remove="build\**" />
    <Compile Remove="build\**" />
    <EmbeddedResource Remove="build\**" />
    <CoreAsset Include="$(CopyToOutputDir)*" />
  </ItemGroup>
  <Target Name="DeployCoreToSpt" AfterTargets="Build" Condition="'$(DeployToSpt)' == 'true'">
    <MakeDir Directories="$(SptBepInExPluginsDir)$(SolutionName)" />
    <Copy SourceFiles="$(TargetPath);@(CoreAsset)" DestinationFolder="$(SptBepInExPluginsDir)$(SolutionName)" />
  </Target>
  <Target Name="CreateMainReleaseZip" AfterTargets="Build" Condition="'$(CreateReleaseArchive)' == 'true'">
    <PropertyGroup>
      <ReleaseStageDir>$(BaseIntermediateOutputPath)release\</ReleaseStageDir>
      <ReleasePluginDir>$(ReleaseStageDir)BepInEx\plugins\$(SolutionName)\</ReleasePluginDir>
    </PropertyGroup>
    <Error Condition="!Exists('$(CopyToOutputDir)sikorsky_uh60_blackhawk.bundle')" Text="Extract sikorsky_uh60_blackhawk.bundle from mod/SamSWAT.HeliCrash/Assets.7z into $(CopyToOutputDir) before packaging." />
    <RemoveDir Directories="$(ReleaseStageDir)" />
    <MakeDir Directories="$(ReleasePluginDir);$(DistributionDir)" />
    <Copy SourceFiles="$(TargetPath);@(CoreAsset)" DestinationFolder="$(ReleasePluginDir)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\LICENSE;$(MSBuildThisFileDirectory)..\..\RELEASE_NOTES.md" DestinationFolder="$(ReleasePluginDir)" />
    <Delete Files="$(ReleaseArchivePath)" />
    <Exec WorkingDirectory="$(ReleaseStageDir)" Command="&quot;C:\Program Files\7-Zip\7z.exe&quot; a -t7z &quot;$(ReleaseArchivePath)&quot; &quot;BepInEx\plugins\$(SolutionName)\*&quot;" />
  </Target>
</Project>
